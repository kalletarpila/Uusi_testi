{
    "name": "enneagrammiyhdistys/invite-app",
    "description": "Enneagrammitestin pilottikutsu-sovellus",
    "type": "project",
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html tests/coverage",
        "test-unit": "phpunit --testsuite Unit",
        "test-integration": "phpunit --testsuite Integration"
    },
    "config": {
        "disable-tls": true,
        "secure-http": false
    }
}
